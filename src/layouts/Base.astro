---
import "../styles/global.css";
import "@fontsource-variable/fraunces/index.css";
import frauncesWoff2 from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import LightboxViewer from "../components/LightboxViewer.astro";
import { getDwellings } from "../lib/dwellings";
import emblem from "../assets/images/the-hillside-retreat-emblem.png";
import heroPoster from "../assets/images/hero-poster.jpg";
import type { ImageMetadata } from "astro";

export const BOOK_URL = "/book/";

/** Umami event name for links into the booking engine, undefined for any other href. */
export const bookingEvent = (href: string) => (href.startsWith(BOOK_URL) ? "booking-click" : undefined);

/** Stable node identity for the business, referenced from per-page JSON-LD
 * (dwelling containedInPlace) so answer engines merge every page's
 * structured data into one entity. */
export const BUSINESS_ID = "https://www.thehillside.com.au/#business";

interface Props {
  title: string;
  description?: string;
  /** Page-specific structured data, emitted alongside the LodgingBusiness JSON-LD. */
  extraJsonLd?: object | object[];
  /** Share image for link previews; defaults to the hero drone still. */
  ogImage?: ImageMetadata;
  preloadImage?: string;
  /** Emits robots noindex and omits the canonical and og:url. */
  noindex?: boolean;
}

const { title, description = "The Hillside Retreat — secluded accommodation on Tamborine Mountain in the Gold Coast Hinterland, with coastal views, pool and heated spa.", extraJsonLd, ogImage = heroPoster, preloadImage, noindex = false } = Astro.props;

// Pages pass a bare page name; the site name is appended here. A title that
// already carries the site name (the homepage) is used as-is.
const fullTitle = title.includes("The Hillside Retreat")
  ? title
  : `${title} — The Hillside Retreat`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const ogImageOptimized = await getImage({
  src: ogImage,
  width: 1200,
  format: "jpg",
});
const ogImageUrl = new URL(ogImageOptimized.src, Astro.site);

const nav = [
  {
    href: "/#accommodation",
    label: "Accommodation",
    children: [
      { href: "/hillside-house/", label: "Hillside House" },
      { href: "/hillside-villa/", label: "Hillside Villa" },
      { href: "/house-and-villa/", label: "House & Villa" },
    ],
  },
  { href: "/gallery/", label: "Gallery" },
  { href: "/reviews/", label: "Reviews" },
  {
    href: "/guest-info/",
    label: "Your Stay",
    children: [
      { href: "/location/", label: "Location" },
      { href: "/faq/", label: "FAQ" },
      { href: "/guest-info/", label: "Guest Info" },
      { href: "/mountain-mobile-massage/", label: "Mobile Massage" },
    ],
  },
  { href: "/contact-us/", label: "Your Hosts" },
];

// aria-current for the link matching the page being rendered. A dropdown
// parent whose child matches gets aria-current="true". The section is
// current and the exact page is the child, even when the parent shares its href.
const current = (href: string) =>
  href === Astro.url.pathname ? "page" : undefined;
const currentSection = (children: { href: string }[]) =>
  children.some((c) => c.href === Astro.url.pathname) ? "true" : undefined;

// Footer "Explore" column: every leaf page from the nav (dropdown children
// replace their parent link).
const footerLinks = nav.flatMap((item) =>
  "children" in item && item.children ? item.children : [item],
);

const { house, villa, combined } = await getDwellings();

const profileUrls = (await getCollection("reviewSources")).map(({ data }) => data.url);

const heroPosterOptimized = await getImage({ src: heroPoster, width: 1200, format: "jpg" });

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.thehillside.com.au/#website",
      name: "The Hillside Retreat",
      url: Astro.site!.href,
      publisher: { "@id": BUSINESS_ID },
    },
    {
      "@type": "LodgingBusiness",
      "@id": BUSINESS_ID,
      name: "The Hillside Retreat",
      url: Astro.site!.href,
      description: `Secluded, tranquil accommodation on Tamborine Mountain in the Gold Coast Hinterland. Hillside House (${house.bedrooms.length}-bedroom, sleeps ${house.sleeps}) and Hillside Villa (${villa.bedrooms.length}-bedroom, sleeps ${villa.sleeps}), bookable separately or combined for up to ${combined.sleeps} guests.`,
      email: "stay@thehillside.com.au",
      telephone: "+61466990185",
      image: [new URL(heroPosterOptimized.src, Astro.site).href],
      address: {
        "@type": "PostalAddress",
        streetAddress: "25 Leona Court",
        addressLocality: "Tamborine Mountain",
        addressRegion: "QLD",
        postalCode: "4272",
        addressCountry: "AU",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: -27.957222,
        longitude: 153.224167,
      },
      priceRange: "AUD $260–$635 per night",
      sameAs: profileUrls,
      checkinTime: "14:00",
      checkoutTime: "10:00",
      petsAllowed: false,
      smokingAllowed: false,
      amenityFeature: [
        { "@type": "LocationFeatureSpecification", name: "Swimming pool", value: true },
        { "@type": "LocationFeatureSpecification", name: "Heated spa", value: true },
        { "@type": "LocationFeatureSpecification", name: "Wood fireplace", value: true },
        { "@type": "LocationFeatureSpecification", name: "Air-conditioning", value: true },
        { "@type": "LocationFeatureSpecification", name: "Ceiling fans", value: true },
        { "@type": "LocationFeatureSpecification", name: "Coastal and valley views", value: true },
        { "@type": "LocationFeatureSpecification", name: "Gas BBQ", value: true },
        { "@type": "LocationFeatureSpecification", name: "Coffee machine", value: true },
        { "@type": "LocationFeatureSpecification", name: "Oven, hob and microwave", value: true },
        { "@type": "LocationFeatureSpecification", name: "Smart TV with Netflix", value: true },
        { "@type": "LocationFeatureSpecification", name: "Wi-Fi", value: true },
        { "@type": "LocationFeatureSpecification", name: "Bed linen, towels and toiletries supplied", value: true },
        { "@type": "LocationFeatureSpecification", name: "Cots and extra beds on request", value: true },
        { "@type": "LocationFeatureSpecification", name: "EV charging (7.3 kW Type 2)", value: true },
        { "@type": "LocationFeatureSpecification", name: "Free private parking", value: true },
      ],
      potentialAction: {
        "@type": "ReserveAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: new URL(BOOK_URL, Astro.site).href,
          actionPlatform: [
            "https://schema.org/DesktopWebPlatform",
            "https://schema.org/MobileWebPlatform",
          ],
        },
      },
    },
  ],
};

const extraJsonLdBlocks = extraJsonLd
  ? Array.isArray(extraJsonLd)
    ? extraJsonLd
    : [extraJsonLd]
  : [];
---

<html lang="en-AU">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
<link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesWoff2} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="The Hillside Retreat" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImageOptimized.attributes.width)} />
<meta property="og:image:height" content={String(ogImageOptimized.attributes.height)} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="a3ea87f9-e118-444b-8a27-49aa9ac101cb" data-domains="www.thehillside.com.au,thehillside.com.au"></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{extraJsonLdBlocks.map((block) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
))}
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header>
  <a href="/" class="brand" aria-current={current("/")}>
    <Image src={emblem} alt="" height={64} densities={[1, 2]} loading="eager" />
    <span class="brand-name">The Hillside Retreat</span>
  </a>
  {/* The toggle precedes the nav so Tab moves from it into the open mobile
      menu. Flex order places the Book button before it on screen. */}
  <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <nav id="site-nav">
    {nav.map((item, n) =>
      "children" in item && item.children ? (
        <div class="nav-drop">
          <a class="nav-parent slide-underline" href={item.href} aria-current={currentSection(item.children) ?? current(item.href)}>
            {item.label}
          </a>
          <button class="drop-toggle" type="button" aria-expanded="false" aria-controls={`drop-${n}`} aria-label={`${item.label} pages`}>
            <span class="caret" aria-hidden="true">▾</span>
          </button>
          <div class="drop-menu" id={`drop-${n}`}>
            {item.children.map((c) => <a href={c.href} aria-current={current(c.href)}><span class="slide-underline">{c.label}</span></a>)}
          </div>
        </div>
      ) : (
        <a class="slide-underline" href={item.href} aria-current={current(item.href)}>{item.label}</a>
      ),
    )}
  </nav>
  <a class="btn nav-book" href={BOOK_URL} data-umami-event="booking-click">Book Direct</a>
</header>

<script>
  const header = document.querySelector("header")!;
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const setMenu = (open: boolean) => {
    header.classList.toggle("nav-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  };
  toggle?.addEventListener("click", () => setMenu(!header.classList.contains("nav-open")));

  const drops = [...document.querySelectorAll<HTMLElement>(".nav-drop")];
  const setDrop = (drop: HTMLElement, open: boolean) => {
    drop.classList.toggle("open", open);
    drop.querySelector(".drop-toggle")?.setAttribute("aria-expanded", String(open));
  };
  const closeDrops = () => drops.forEach((d) => setDrop(d, false));

  drops.forEach((drop) => {
    drop.querySelector(".drop-toggle")?.addEventListener("click", () => {
      const open = !drop.classList.contains("open");
      closeDrops();
      setDrop(drop, open);
    });
    drop.addEventListener("focusout", (e) => {
      if (!drop.contains(e.relatedTarget as Node | null)) setDrop(drop, false);
    });
    drop.addEventListener("mouseleave", () => drop.classList.remove("dismissed"));
  });

  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".nav-drop")) closeDrops();
  });

  // Escape closes an open or hovered dropdown first, then the mobile menu.
  // Focus inside a closing dropdown moves to its caret button, and closing the
  // mobile menu focuses the toggle.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const drop = drops.find((d) => d.classList.contains("open") || d.matches(":hover"));
    if (drop) {
      const focusedInside = drop.contains(document.activeElement);
      setDrop(drop, false);
      if (drop.matches(":hover")) drop.classList.add("dismissed");
      if (focusedInside) drop.querySelector<HTMLElement>(".drop-toggle")?.focus();
    } else if (header.classList.contains("nav-open")) {
      setMenu(false);
      toggle?.focus();
    }
  });

  // Wide touch devices (tablets) get no hover: first tap opens the dropdown,
  // a second tap on the parent follows its link. Desktop keeps hover + plain
  // click. Below the mobile breakpoint the panel shows sub-links inline, so
  // parent links navigate on first tap.
  if (window.matchMedia("(hover: none) and (min-width: 56.0625rem)").matches) {
    drops.forEach((drop) => {
      drop.querySelector(".nav-parent")?.addEventListener("click", (e) => {
        if (!drop.classList.contains("open")) {
          e.preventDefault();
          closeDrops();
          setDrop(drop, true);
        }
      });
    });
  }
</script>

<main id="main">
  <slot />
</main>

<LightboxViewer />

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-brand-row">
        <Image src={emblem} alt="" height={64} densities={[1, 2]} />
        <span class="footer-wordmark">The Hillside Retreat</span>
      </span>
      <p>Secluded, tranquil accommodation on Tamborine Mountain, in the Gold Coast Hinterland.</p>
    </div>
    <nav class="footer-col" aria-label="Footer">
      <h2>Explore</h2>
      <div class="footer-links">
        {footerLinks.map((l) => <a class="slide-underline" href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      </div>
    </nav>
    <div class="footer-col">
      <h2>Contact</h2>
      <p>25 Leona Court<br />Tamborine Mountain QLD 4272</p>
      <a class="slide-underline" href="tel:+61466990185">(+61) 0466 990 185</a>
      <a class="slide-underline" href="mailto:stay@thehillside.com.au?subject=Enquiry%3A%20Hillside%20Retreat">stay@thehillside.com.au</a>
    </div>
    <div class="footer-col">
      <h2>Book</h2>
      <p>Two hillside dwellings — book one, or both together.</p>
      <a class="btn btn-outline" href={BOOK_URL} data-umami-event="booking-click">Book with us</a>
    </div>
  </div>
  <div class="footer-base">
    <p>© {new Date().getFullYear()} The Hillside Retreat · Tamborine Mountain, Queensland</p>
  </div>
</footer>

</body>
</html>
