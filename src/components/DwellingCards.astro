---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import FactsLine from "./FactsLine.astro";
import { getDwellings } from "../lib/dwellings";
import combinedAerial from "../assets/images/drone/aerial-view-whole-property.jpg";

interface Props {
  dwellings: {
    slug: string;
    href: string;
    image: { src: ImageMetadata; alt: string };
    line: string;
  }[];
  combinedLine: string;
}
const { dwellings, combinedLine } = Astro.props;

const cards = await Promise.all(
  dwellings.map(async (d) => {
    const entry = await getEntry("pages", d.slug);
    const facts = entry?.data.dwelling;
    if (!facts) throw new Error(`No dwelling frontmatter on ${d.slug}`);
    return { ...d, facts };
  }),
);

const { combined: combinedFacts } = await getDwellings();
const combined = {
  sleeps: combinedFacts.sleeps,
  bedrooms: combinedFacts.bedrooms.length,
  bathrooms: combinedFacts.bathrooms,
};
---

<section class="dwellings" id="accommodation">
  <h2>Two places to stay</h2>
  <div class="pair">
    {cards.map((card) => (
      <article>
        <a class="card-photo" href={card.href} aria-label={`See ${card.facts.name}`}>
          <Image
            src={card.image.src}
            alt={card.image.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 40rem) 100vw, 50vw"
            loading="lazy"
          />
        </a>
        <h3><a class="card-title slide-underline" href={card.href}>{card.facts.name}</a></h3>
        <FactsLine
          sleeps={card.facts.sleeps}
          bedrooms={card.facts.bedrooms.length}
          bathrooms={card.facts.bathrooms}
        />
        <p>{card.line}</p>
        <a class="btn" href={card.href}>See {card.facts.name}</a>
      </article>
    ))}
  </div>
  <article class="combined">
    <a class="card-photo" href="/house-and-villa/" aria-label="About House &amp; Villa">
      <Image
        src={combinedAerial}
        alt="Aerial view of the whole property, House and Villa together on the hillside"
        widths={[480, 800, 1200]}
        sizes="(max-width: 40rem) 100vw, 55vw"
        loading="lazy"
      />
    </a>
    <div>
      <h3><a class="card-title slide-underline" href="/house-and-villa/">House &amp; Villa combined</a></h3>
      <FactsLine {...combined} />
      <p>{combinedLine}</p>
      <a class="btn btn-outline" href="/house-and-villa/">About House &amp; Villa</a>
    </div>
  </article>
</section>

<style>
  .dwellings {
    margin: 0 0 4rem;
  }
  .pair {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    column-gap: 2.5rem;
  }
  article {
    border-top: 2px solid var(--highlight);
    padding-top: 1.25rem;
  }
  /* Both image blocks end at the same y: the Villa image's top margin
     (11.25% of its column) equals the height its narrower 4:3 image loses
     against the wider House column, so titles and facts lines align while
     the top edge staggers. Buttons bottom-align via margin-top: auto. */
  .pair article {
    display: flex;
    flex-direction: column;
  }
  .pair article:nth-child(2) img {
    margin-top: 11.25%;
  }
  .pair article .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  article img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
  }
  article h3 {
    margin: 1rem 0 0.25rem;
  }
  article .btn {
    margin-top: 0.5rem;
  }
  .combined {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 3rem;
    border-top: 2px solid var(--highlight);
    padding-top: 1.25rem;
  }
  .combined img {
    aspect-ratio: 16 / 9;
  }
  .combined h3 {
    margin: 0 0 0.25rem;
  }
  .combined p:not(.facts-line) {
    text-wrap: balance;
    margin: 0 0 0.5rem;
  }
  @media (max-width: 40rem) {
    .pair {
      grid-template-columns: 1fr;
    }
    .pair article:nth-child(2) {
      margin-top: 2.5rem;
    }
    .pair article:nth-child(2) img {
      margin-top: 0;
    }
    .combined {
      grid-template-columns: 1fr;
    }
  }
</style>
