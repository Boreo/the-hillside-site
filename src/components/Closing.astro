---
import { BOOK_URL } from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { inFileOrder } from "../lib/file-order";
import sourcesRaw from "../content/review-sources.yaml?raw";

interface Props {
  image: { src: ImageMetadata; alt: string };
  line: string;
}
const { image, line } = Astro.props;

const sources = inFileOrder(await getCollection("reviewSources"), sourcesRaw).filter(
  ({ data }) => data.rating !== null && data.count !== null,
);
const ratings = new Intl.ListFormat("en-AU").format(
  sources.map(({ data }) => `${data.rating} out of ${data.scale} on ${data.platform}`),
);
---

<section class="closing">
  <Image
    src={image.src}
    alt={image.alt}
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 71rem) 100vw, 68rem"
    loading="lazy"
  />
  <p class="closing-line">{line}</p>
  <a class="btn" href={BOOK_URL} data-umami-event="booking-click">Book with us</a>
  {
    sources.length > 0 && (
      <p class="closing-ratings">
        Our guests rate us {ratings}.
        <a class="editorial-link" href="/reviews/">Read what guests say</a>
      </p>
    )
  }
</section>

<style>
  .closing {
    text-align: center;
    margin: 0 0 2rem;
  }
  img {
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: 8px;
  }
  .closing-line {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-settings);
    font-weight: 500;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    color: var(--accent-dark);
    margin: 1.5rem 0 1.25rem;
  }
  .closing-ratings {
    font-size: 0.95rem;
    color: var(--muted);
    text-wrap: balance;
    margin: 1.25rem auto 0;
  }
  .closing-ratings a {
    display: block;
    width: fit-content;
    margin: 0.4rem auto 0;
  }
</style>
