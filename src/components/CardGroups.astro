---
import { Image, getImage } from "astro:assets";
import FactIcon from "./FactIcon.astro";
import { factIconHtml } from "../lib/fact-icon-paths.mjs";

interface Fact {
  icon: "walk" | "car" | "calendar" | "clock";
  label: string;
}
interface Item {
  name: string;
  facts: Fact[];
  tag?: string;
  blurb?: string;
  addons?: string;
  link?: { href: string; label: string };
  image?: { src: ImageMetadata; alt: string };
}
interface Props {
  groups: { heading: string; intro?: string; items: Item[] }[];
}
const { groups } = Astro.props;

// Group intros are plain frontmatter strings but may carry markdown links
// (e.g. to the QPWS track map). Escape everything, then rebuild only the
// [text](url) links as anchors, allowing only web, root-relative and
// fragment URLs.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const outIcon = factIconHtml("arrow-out", "out-icon");

const fullUrls = new Map<ImageMetadata, string>();
for (const group of groups)
  for (const item of group.items)
    if (item.image)
      fullUrls.set(
        item.image.src,
        (await getImage({ src: item.image.src, width: item.image.src.width })).src,
      );
const renderIntro = (s: string) =>
  escapeHtml(s).replace(
    /\[([^\]]+)\]\(((?:https?:|\/|#)[^)\s]*)\)/g,
    (_, label, href) =>
      `<a href="${href}">${label}${href.startsWith("http") ? outIcon : ""}</a>`,
  );
---

{
  groups.map((group) => (
    <section class="place-group">
      <h2>{group.heading}</h2>
      {group.intro && <p class="place-intro" set:html={renderIntro(group.intro)} />}
      <div class="place-grid">
        {group.items.map((p) => (
          <article class="place-card">
            {p.image && (
              <a
                href={fullUrls.get(p.image.src)}
                class="lightbox-open"
                aria-label={`Enlarge photo: ${p.image.alt}`}
              >
                <Image
                  src={p.image.src}
                  alt={p.image.alt}
                  widths={[480, 800]}
                  sizes="(max-width: 40rem) 100vw, 30rem"
                />
              </a>
            )}
            <h3>{p.name}</h3>
            {(p.facts.length > 0 || p.tag) && (
              <p class="place-facts">
                {p.facts.map((f) => (
                  <span class="place-fact">
                    <FactIcon name={f.icon} /> {f.label}
                  </span>
                ))}
                {p.tag && <span class="place-tag">{p.tag}</span>}
              </p>
            )}
            {p.blurb && (
              <p class="place-blurb">
                {p.blurb
                  .trim()
                  .split("\n")
                  .map((line) => (
                    <span>{line}</span>
                  ))}
              </p>
            )}
            {p.addons && <p class="treatment-addons">{p.addons}</p>}
            {p.link && (
              <a class="place-link" href={p.link.href}>
                {p.link.label}
                {p.link.href.startsWith("http") && <FactIcon name="arrow-out" />}
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  ))
}
